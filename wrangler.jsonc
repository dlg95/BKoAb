{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bkoab",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "BkoabContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BKOAB_CONTAINER",
        "class_name": "BkoabContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BkoabContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
